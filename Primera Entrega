        "import requests\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import time\n",
        "import json\n",
        "from sklearn.cluster import KMeans\n",
        "\n",
        "# API KEYS (Reemplaza con tus propias claves)\n",
        "OPENWEATHERMAP_API_KEY = \"98940a38d8de5cf1b5a0d3cd788546b0\"\n",
        "WAQI_API_KEY = \"7fd87894692b14cf3bc7e3e68c937ffdd32a7e2c\"\n",
        "\n",
        "# Lista de ciudades a analizar\n",
        "CITIES = [\"New York\", \"London\", \"Paris\", \"Beijing\", \"Delhi\", \"Buenos Aires\", \"Tokyo\", \"Sydney\", \"Moscow\", \"Los Angeles\", \"Mexico City\", \"Cairo\", \"Berlin\", \"São Paulo\", \"Jakarta\", \"Toronto\", \"Lagos\", \"Bangkok\", \"Madrid\", \"Seoul\", \"Nairobi\", \"Istanbul\", \"Singapore\", \"Dubai\", \"Johannesburg\", \"Shanghai\", \"Hong Kong\", \"Riyadh\", \"Melbourne\", \"Chicago\", \"Osaka\", \"Bogotá\", \"Lima\", \"Manila\", \"Hanoi\", \"Caracas\", \"Tehran\", \"Kolkata\", \"Karachi\", \"Kuala Lumpur\", \"Brussels\", \"Vienna\", \"Stockholm\", \"Warsaw\", \"Helsinki\", \"Athens\", \"Dublin\", \"Lisbon\", \"Copenhagen\", \"Zurich\", \"Amsterdam\"]\n",
        "\n",
        "# OpenWeatherMap API URL\n",
        "OWM_URL = \"https://api.openweathermap.org/data/2.5/weather\"\n",
        "\n",
        "# World Air Quality Index API URL\n",
        "WAQI_URL = \"https://api.waqi.info/feed/{}/?token={}\"\n",
        "\n",
        "# Listas para almacenar los datos\n",
        "weather_data = []\n",
        "air_quality_data = []\n",
        "\n",
        "###########################################\n",
        "# 1. Obtener datos climáticos desde OpenWeatherMap\n",
        "###########################################\n",
        "for city in CITIES:\n",
        "    params = {\"q\": city, \"appid\": OPENWEATHERMAP_API_KEY, \"units\": \"metric\"}\n",
        "    response = requests.get(OWM_URL, params=params)\n",
        "\n",
        "    if response.status_code == 200:\n",
        "        data = response.json()\n",
        "        weather_data.append({\n",
        "            \"city\": city,\n",
        "            \"temperature\": data[\"main\"].get(\"temp\"),\n",
        "            \"humidity\": data[\"main\"].get(\"humidity\"),\n",
        "            \"pressure\": data[\"main\"].get(\"pressure\"),\n",
        "            \"wind_speed\": data[\"wind\"].get(\"speed\") if \"wind\" in data else None\n",
        "        })\n",
        "    else:\n",
        "        print(f\"Error obteniendo datos climáticos para {city}\")\n",
        "\n",
        "    time.sleep(1)  # Evitar sobrecargar la API\n",
        "\n",
        "# Crear DataFrame de clima\n",
        "weather_df = pd.DataFrame(weather_data)\n",
        "\n",
        "###########################################\n",
        "# 2. Obtener datos de calidad del aire desde WAQI\n",
        "###########################################\n",
        "for city in CITIES:\n",
        "    response = requests.get(WAQI_URL.format(city, WAQI_API_KEY))\n",
        "\n",
        "    if response.status_code == 200:\n",
        "        data = response.json()\n",
        "        if \"data\" in data and \"aqi\" in data[\"data\"]:\n",
        "            air_quality_data.append({\n",
        "                \"city\": city,\n",
        "                \"aqi\": data[\"data\"].get(\"aqi\"),\n",
        "                \"pm2_5\": data[\"data\"].get(\"iaqi\", {}).get(\"pm25\", {}).get(\"v\", None),\n",
        "                \"no2\": data[\"data\"].get(\"iaqi\", {}).get(\"no2\", {}).get(\"v\", None)\n",
        "            })\n",
        "        else:\n",
        "            print(f\"Datos de calidad del aire no disponibles para {city}\")\n",
        "    else:\n",
        "        print(f\"Error obteniendo calidad del aire para {city}\")\n",
        "\n",
        "    time.sleep(1)  # Evitar sobrecargar la API\n",
        "\n",
        "# Crear DataFrame de calidad del aire\n",
        "air_quality_df = pd.DataFrame(air_quality_data)\n",
        "\n",
        "###########################################\n",
        "# 3. Unir los datasets\n",
        "###########################################\n",
        "merged_df = pd.merge(weather_df, air_quality_df, on=\"city\", how=\"inner\")\n",
        "\n",
        "# Reemplazar caracteres no numéricos por NaN antes de convertir\n",
        "cols_to_convert = [\"aqi\", \"pm2_5\", \"no2\"]\n",
        "for col in cols_to_convert:\n",
        "    # Reemplaza todo lo que no sea digitos, +, -, o . con \"\"\n",
        "    merged_df[col] = merged_df[col].astype(str).replace(r\"[^0-9.+-]\", \"\", regex=True)\n",
        "    # Reemplaza exactamente '-' por NaN\n",
        "    merged_df[col] = merged_df[col].replace('-', np.nan)\n",
        "    merged_df[col] = pd.to_numeric(merged_df[col], errors='coerce')\n",
        "\n",
        "# Guardar datos en CSV\n",
        "weather_df.to_csv(\"weather_data.csv\", index=False)\n",
        "air_quality_df.to_csv(\"air_quality_data.csv\", index=False)\n",
        "merged_df.to_csv(\"merged_data.csv\", index=False)"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "###########################################\n",
        "# ANÁLISIS EXPLORATORIO (GRÁFICOS MÁS AMIGABLES)\n",
        "###########################################\n",
        "\n",
        "# 1) Distribución de Temperatura\n",
        "plt.figure(figsize=(10,5))\n",
        "sns.histplot(merged_df[\"temperature\"], bins=20, kde=True, color='blue')\n",
        "plt.title(\"Distribución de Temperatura\")\n",
        "plt.xlabel(\"Temperatura (°C)\")\n",
        "plt.ylabel(\"Frecuencia\")\n",
        "plt.show()\n",
        "\n",
        "# 2) Distribución del índice de calidad del aire (AQI)\n",
        "plt.figure(figsize=(10,5))\n",
        "aqi_clean = merged_df[\"aqi\"].dropna()\n",
        "sns.histplot(aqi_clean, bins=20, kde=True, color='red')\n",
        "plt.title(\"Distribución del Índice de Calidad del Aire (AQI)\")\n",
        "plt.xlabel(\"AQI\")\n",
        "plt.ylabel(\"Frecuencia\")\n",
        "plt.show()\n",
        "\n",
        "# 3) Relación entre Temperatura y Calidad del Aire (agrupada)\n",
        "# Para no mostrar las 50 ciudades, se hace un scatter normal sin etiquetar cada ciudad\n",
        "plt.figure(figsize=(10,5))\n",
        "sns.scatterplot(data=merged_df, x=\"temperature\", y=\"aqi\", color='green')\n",
        "plt.title(\"Relación entre Temperatura y AQI\")\n",
        "plt.xlabel(\"Temperatura (°C)\")\n",
        "plt.ylabel(\"AQI\")\n",
        "plt.show()\n",
        "\n",
        "# 4) Boxplot de Humedad\n",
        "plt.figure(figsize=(10,5))\n",
        "sns.boxplot(x=merged_df[\"humidity\"], color='purple')\n",
        "plt.title(\"Distribución de la Humedad\")\n",
        "plt.xlabel(\"Humedad (%)\")\n",
        "plt.show()\n",
        "\n",
        "# 5) Boxplot de Velocidad del Viento\n",
        "plt.figure(figsize=(10,5))\n",
        "sns.boxplot(x=merged_df[\"wind_speed\"], color='orange')\n",
        "plt.title(\"Distribución de la Velocidad del Viento\")\n",
        "plt.xlabel(\"Velocidad del Viento (m/s)\")\n",
        "plt.show()\n",
        "\n",
        "# 6) Relación entre Humedad y AQI (agrupada)\n",
        "plt.figure(figsize=(10,5))\n",
        "sns.scatterplot(data=merged_df, x=\"humidity\", y=\"aqi\", color='brown')\n",
        "plt.title(\"Relación entre Humedad y AQI\")\n",
        "plt.xlabel(\"Humedad (%)\")\n",
        "plt.ylabel(\"AQI\")\n",
        "plt.show()\n",
        "\n",
        "###########################################\n",
        "# AGRUPACIÓN DE CIUDADES VIA KMEANS (Simplificar Vista)\n",
        "###########################################\n",
        "\n",
        "# Seleccionamos columnas numéricas para el clustering\n",
        "clustering_df = merged_df[[\"temperature\", \"humidity\", \"pressure\", \"wind_speed\", \"aqi\", \"pm2_5\", \"no2\"]].dropna()\n",
        "\n",
        "# Rellenar datos faltantes (opcional)\n",
        "# clustering_df = clustering_df.fillna(clustering_df.mean())  # si se desea\n",
        "\n",
        "# Ajustar K-means con 3 clusters (ejemplo)\n",
        "kmeans = KMeans(n_clusters=3, random_state=42)\n",
        "clusters = kmeans.fit_predict(clustering_df)\n",
        "clustering_df[\"cluster\"] = clusters\n",
        "\n",
        "# Promedio de cada variable por cluster\n",
        "cluster_means = clustering_df.groupby(\"cluster\").mean()\n",
        "\n",
        "# 7) Barplot de promedio de variables por cluster (Temperatura, Humedad, AQI)\n",
        "variables_to_plot = [\"temperature\", \"humidity\", \"aqi\"]\n",
        "fig, ax = plt.subplots(1, len(variables_to_plot), figsize=(18,5))\n",
        "fig.suptitle(\"Promedio de Variables por Cluster\")\n",
        "\n",
        "for i, var in enumerate(variables_to_plot):\n",
        "    ax[i].bar(cluster_means.index.astype(str), cluster_means[var], color=['blue','red','green'])\n",
        "    ax[i].set_title(f\"Promedio de {var}\")\n",
        "    ax[i].set_xlabel(\"Cluster\")\n",
        "    ax[i].set_ylabel(var)\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# 8) Conteo de ciudades en cada cluster\n",
        "# Para mapear back cities -> cluster\n",
        "merged_clustering = pd.concat([merged_df, clustering_df[\"cluster\"]], axis=1)\n",
        "\n",
        "cluster_counts = merged_clustering[\"cluster\"].value_counts()\n",
        "plt.figure(figsize=(6,4))\n",
        "cluster_counts.plot(kind=\"bar\", color=['blue','red','green'], alpha=0.7)\n",
        "plt.title(\"Cantidad de Registros por Cluster\")\n",
        "plt.xlabel(\"Cluster\")\n",
        "plt.ylabel(\"Cantidad\")\n",
        "plt.show()\n",
        "\n",
        "print(\"Cluster Means:\\n\", cluster_means)\n",
        "print(\"\\nRegistros por cluster:\\n\", cluster_counts)\n"
      ],
